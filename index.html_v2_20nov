    if (!payMethod) return fail('পেমেন্ট মেথড সিলেক্ট করুন');
    if (!amount || amount < S.minDeposit) return fail('সর্বনিম্ন ডিপোজিট ৳' + S.minDeposit);
    if (sender.length < 6) return fail('যে নম্বর থেকে টাকা পাঠিয়েছেন সেটি দিন');
    if (trxId.length < 6) return fail('সঠিক Transaction ID দিন');
    $('depBtn').disabled = true;
    try {
        await api('/deposit', { method: 'POST', body: { amount, method: payMethod, sender, trxId } }, true);
        $('addAmt').value = ''; $('depSender').value = ''; $('depTrx').value = '';
        toast('রিকোয়েস্ট জমা হয়েছে। অ্যাডমিন যাচাই করে ব্যালেন্স যোগ করবে।', 'success'); go('walletScreen');
    } catch (e) { fail(e.message); }
    finally { $('depBtn').disabled = false; }
}

boot();
</script>
</body>
</html>
