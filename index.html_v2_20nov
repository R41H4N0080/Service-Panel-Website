<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script>
/* ==========================================================================
   SERVICE BD — FRONTEND
   এই ফাইলে কোনো ডেটা/কনফিগ নেই। সব কিছু /api (backend) থেকে আসে।
   Backend না চললে সাইট শুধু Error screen দেখায়।
   ========================================================================== */
const API = '/api';
let S = null, CATS = [], SVCS = [];
let fbAuth = null, user = null;
let orders = [], wallet = { txns: [], deposits: [] };
let currentCat = null, currentService = null, historyFilter = 'all', searchQ = '', payMethod = '';
let regNameTmp = '', authMode = 'login', sliderTimer = null, pollTimer = null, booted = false;

const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nl2br = s => esc(s).replace(/\n/g, '<br>');
const money = n => '৳' + (Math.round(Number(n || 0) * 100) / 100).toLocaleString('en-US', { maximumFractionDigits: 2 });
const catOf = id => CATS.find(c => c.id === id);
const fmtDate = ts => new Date(ts).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
const safeCls = s => String(s).replace(/[^A-Za-z]/g, '');

/* ---------- API ---------- */
async function api(path, opt, needAuth) {
    opt = opt || {};
    const headers = { 'Content-Type': 'application/json' };
    if (needAuth) {
        if (!fbAuth || !fbAuth.currentUser) throw new Error('লগইন করুন');
        headers.Authorization = 'Bearer ' + await fbAuth.currentUser.getIdToken();
    }
    let res;
    try {
        res = await fetch(API + path, { method: opt.method || 'GET', headers, body: opt.body ? JSON.stringify(opt.body) : undefined });
    } catch (e) { const er = new Error('সার্ভারের সাথে যোগাযোগ করা যাচ্ছে না'); er.network = true; throw er; }
    let data = null;
    try { data = await res.json(); } catch (e) {}
    if (!res.ok) { const er = new Error((data && data.error) || 'সমস্যা হয়েছে (' + res.status + ')'); er.status = res.status; throw er; }
    return data;
}

/* ---------- UI helpers ---------- */
function toast(msg, type) {
    type = type || 'info';
    const ic = { success:'fa-circle-check', error:'fa-circle-xmark', info:'fa-circle-info' }[type];
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.innerHTML = '<i class="fas ' + ic + '"></i><span>' + esc(msg) + '</span>';
    $('toastWrap').appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .3s'; setTimeout(() => el.remove(), 300); }, 3200);
}
function showAlert(title, msg, type) {
    type = type || 'warning';
    const ic = { warning:'fa-exclamation-triangle', error:'fa-times-circle', success:'fa-check-circle' }[type];
    $('alertIconWrap').className = 'modal-icon ' + type;
    $('alertIconWrap').innerHTML = '<i class="fas ' + ic + '"></i>';
    $('alertTitle').textContent = title; $('alertMsg').textContent = msg;
    $('customAlert').classList.add('show');
}
function closeCustomAlert() { $('customAlert').classList.remove('show'); }
const openModal = id => $(id).classList.add('show');
const closeModal = id => $(id).classList.remove('show');
function openAuth() { setAuthMode('login'); $('authErr').classList.remove('show'); $('authWrap').classList.add('show'); }
function closeAuth() { $('authWrap').classList.remove('show'); }
function openSidebar() { $('sidebarMenu').classList.add('show'); $('sidebarOverlay').classList.add('show'); }
function closeSidebar() { $('sidebarMenu').classList.remove('show'); $('sidebarOverlay').classList.remove('show'); }
function toggleFloatSupport() { $('floatSupport').classList.toggle('open'); }
function doLogout() { openModal('logoutModal'); }
function closeLogoutModal() { closeModal('logoutModal'); }
async function executeLogout() {
    closeLogoutModal();
    try { await fbAuth.signOut(); } catch (e) {}
    toast('লগআউট হয়েছে', 'info'); go('home');
}
function setBusy(on) { $('orderLoader').classList.toggle('show', !!on); }

/* ---------- Boot ---------- */
async function boot() {
    $('errScreen').classList.remove('show');
    try {
        const [cfg, data] = await Promise.all([api('/config'), api('/bootstrap')]);
        if (!cfg.firebase || String(cfg.firebase.apiKey).startsWith('YOUR_')) throw new Error('api/server.js এ Firebase Web Config বসানো হয়নি');
        S = data.settings; CATS = data.categories; SVCS = data.services;
        if (!firebase.apps.length) firebase.initializeApp(cfg.firebase);
        fbAuth = firebase.auth();
        if (!currentCat || !catOf(currentCat)) currentCat = CATS.length ? CATS[0].id : null;
        applySettings(); renderTabs(); renderServices();
        if (!booted) { booted = true; fbAuth.onAuthStateChanged(onAuthChange); }
        else if (!fbAuth.currentUser) updateUI();
        $('splash').classList.add('hide');
    } catch (e) {
        $('errMsg').textContent = e.network ? 'ব্যাকএন্ড সার্ভারের সাথে যোগাযোগ করা যাচ্ছে না। ইন্টারনেট চেক করে আবার চেষ্টা করুন।' : e.message;
        $('errScreen').classList.add('show'); $('splash').classList.add('hide');
    }
}

function applySettings() {
    document.title = S.brand + ' - Premium Social Media Services';
    $('brandName').textContent = S.brand; $('authBrand').textContent = S.brand;
    $('copyBrand').textContent = S.brand.replace(/\s+/g, '').toUpperCase();
    $('maintScreen').classList.toggle('show', !!S.maintenance);
    $('noticeText').textContent = S.notice || '';
    $('noticeBox').style.display = S.notice ? 'flex' : 'none';
    const tg = S.telegram ? 'https://t.me/' + S.telegram : '';
    const wa = S.whatsapp ? 'https://wa.me/' + S.whatsapp : '';
    const yt = S.youtube || '', mail = S.email ? 'mailto:' + S.email : '', grp = S.group || '';
    const setL = (el, href) => { if (!el) return; if (href) { el.href = href; el.classList.remove('hidden-link'); } else el.classList.add('hidden-link'); };
    setL($('lnkTg'), tg); setL($('lnkWa'), wa); setL($('lnkGroup'), grp); setL($('lnkYt'), yt); setL($('lnkMail'), mail);
    document.querySelectorAll('.lnkTg').forEach(a => setL(a, tg));
    document.querySelectorAll('.lnkWa').forEach(a => setL(a, wa));
    document.querySelectorAll('.lnkTgItem').forEach(a => a.style.display = tg ? '' : 'none');
    document.querySelectorAll('.lnkWaItem').forEach(a => a.style.display = wa ? '' : 'none');
    if (!tg && !wa) $('floatSupport').style.display = 'none'; else $('floatSupport').style.display = '';
    const sr = document.querySelector('.support-row'); if (!tg && !wa && !grp) sr.style.display = 'none'; else sr.style.display = '';

    const sl = $('sliderBox');
    sl.innerHTML = S.covers.map((c, i) =>
        '<div class="slide-item slide-' + (i % 3 + 1) + '"><i class="' + esc(c.icon) + ' bg-ic"></i><h3>' + esc(c.title).replace(/&lt;br&gt;/g, '<br>') + '</h3><p>' + esc(c.sub) + '</p>' +
        (c.src ? '<img class="cover" src="' + esc(c.src) + '" alt="" loading="' + (i ? 'lazy' : 'eager') + '" onerror="this.remove()">' : '') + '</div>'
    ).join('');
    clearInterval(sliderTimer); let si = 0; sl.style.transform = 'translateX(0)';
    if (S.covers.length > 1) sliderTimer = setInterval(() => { si = (si + 1) % S.covers.length; sl.style.transform = 'translateX(-' + (si * 100) + '%)'; }, 3500);
}
function openLink(k) {
    const u = k === 'wa' ? (S.whatsapp ? 'https://wa.me/' + S.whatsapp : '') : (S.telegram ? 'https://t.me/' + S.telegram : '');
    if (u) window.open(u, '_blank', 'noopener');
}
function showPage(k) {
    const t = { about:'About Us', terms:'Terms & Conditions', privacy:'Privacy Policy', refund:'Refund Policy' }[k];
    const body = (S.pages && S.pages[k]) || '';
    $('infoTitle').textContent = t;
    $('infoBody').innerHTML = body ? nl2br(body) : '<i>এই পেজের তথ্য শীঘ্রই যোগ করা হবে।</i>';
    openModal('infoModal');
}

/* ==========================================================================
   AUTH — Google + Email/Password (Firebase Auth) → ব্যাকএন্ডে ভেরিফাই
   ========================================================================== */
function setAuthMode(m) {
    authMode = m;
    $('tabLogin').classList.toggle('active', m === 'login'); $('tabReg').classList.toggle('active', m === 'register');
    $('regName').style.display = m === 'register' ? 'block' : 'none';
    $('emailBtnTxt').textContent = m === 'register' ? 'Create Account' : 'Login';
    $('forgotBtn').style.display = m === 'login' ? 'inline-block' : 'none';
    $('authPass').autocomplete = m === 'register' ? 'new-password' : 'current-password';
    $('authErr').classList.remove('show');
}
function togglePw() { const p = $('authPass'); p.type = p.type === 'password' ? 'text' : 'password'; }
function authError(msg) { const el = $('authErr'); el.textContent = msg; el.classList.add('show'); }
function fbMsg(e) {
    const m = {
        'auth/invalid-email': 'ইমেইল সঠিক নয়', 'auth/user-not-found': 'এই ইমেইলে কোনো অ্যাকাউন্ট নেই',
        'auth/wrong-password': 'পাসওয়ার্ড ভুল', 'auth/invalid-credential': 'ইমেইল বা পাসওয়ার্ড ভুল',
        'auth/email-already-in-use': 'এই ইমেইলে আগেই অ্যাকাউন্ট আছে — Login করুন', 'auth/weak-password': 'পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের দিন',
        'auth/too-many-requests': 'অনেকবার চেষ্টা করেছেন, একটু পরে আবার চেষ্টা করুন', 'auth/network-request-failed': 'ইন্টারনেট সংযোগ নেই',
        'auth/popup-closed-by-user': 'লগইন বাতিল করা হয়েছে', 'auth/cancelled-popup-request': 'লগইন বাতিল করা হয়েছে',
        'auth/unauthorized-domain': 'এই ডোমেইন Firebase এ Authorized নয় (Authentication → Settings → Authorized domains)',
        'auth/operation-not-allowed': 'Firebase Console এ এই লগইন মেথড চালু করা নেই', 'auth/missing-password': 'পাসওয়ার্ড দিন'
    };
    return m[e.code] || e.message || 'লগইন ব্যর্থ হয়েছে';
}
async function googleLogin() {
    $('authErr').classList.remove('show');
    const p = new firebase.auth.GoogleAuthProvider(); p.setCustomParameters({ prompt: 'select_account' });
    $('googleBtn').disabled = true;
    try { await fbAuth.signInWithPopup(p); }
    catch (e) {
        if (e.code === 'auth/popup-blocked' || e.code === 'auth/operation-not-supported-in-this-environment') { try { await fbAuth.signInWithRedirect(p); return; } catch (e2) { e = e2; } }
        authError(fbMsg(e));
    } finally { $('googleBtn').disabled = false; }
}
async function emailSubmit(ev) {
    ev.preventDefault();
    const email = $('authEmail').value.trim(), pass = $('authPass').value, name = $('regName').value.trim();
    $('authErr').classList.remove('show');
    if (!email || !pass) return authError('ইমেইল ও পাসওয়ার্ড দিন');
    if (authMode === 'register' && name.length < 2) return authError('আপনার নাম লিখুন (কমপক্ষে ২ অক্ষর)');
    $('emailBtn').disabled = true;
    try {
        if (authMode === 'register') { regNameTmp = name; await fbAuth.createUserWithEmailAndPassword(email, pass); }
        else await fbAuth.signInWithEmailAndPassword(email, pass);
    } catch (e) { authError(fbMsg(e)); }
    finally { $('emailBtn').disabled = false; }
}
async function forgotPassword() {
    const email = $('authEmail').value.trim();
    if (!email) return authError('আগে ইমেইল ঘরে আপনার ইমেইল লিখুন');
    try { await fbAuth.sendPasswordResetEmail(email); toast('পাসওয়ার্ড রিসেট লিংক ইমেইলে পাঠানো হয়েছে', 'success'); }
    catch (e) { authError(fbMsg(e)); }
}
async function onAuthChange(fu) {
    if (!fu) { user = null; orders = []; wallet = { txns: [], deposits: [] }; stopPoll(); updateUI(); return; }
    try {
        const r = await api('/me', { method: 'POST', body: { name: regNameTmp || fu.displayName || '' } }, true);
        user = r.user; regNameTmp = '';
        user.photo = user.photo || fu.photoURL || '';
        closeAuth(); updateUI(); toast('স্বাগতম, ' + user.name + '!', 'success'); startPoll();
        loadOrders(true);
    } catch (e) {
        user = null; updateUI();
        try { await fbAuth.signOut(); } catch (x) {}
        showAlert(e.status === 403 ? 'অ্যাকাউন্ট ব্লকড' : 'লগইন সমস্যা', e.message, 'error');
    }
}
function requireLogin() { if (user) return true; openAuth(); return false; }

/* ==========================================================================
   NAVIGATION & UI
   ========================================================================== */
function go(id) {
    if (['orderHistoryScreen', 'walletScreen', 'addMoneyScreen'].includes(id) && !user) { openAuth(); return; }
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    $(id).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    ['home', 'orders', 'wallet'].forEach(k => $('sb-nav-' + k).classList.remove('active'));
    if (id === 'home') $('sb-nav-home').classList.add('active');
