.pay-num { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #FFF7ED; border: 1px dashed #FDBA74; border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 14px; }
.pay-num small { display: block; font-size: 11px; color: var(--text-muted); font-weight: 700; }
.pay-num b { font-size: 18px; font-weight: 900; letter-spacing: .5px; }
.copy-btn { background: var(--primary); color: #fff; border: none; border-radius: 10px; padding: 9px 14px; font-weight: 800; font-size: 12px; cursor: pointer; font-family: inherit; }

.pill { padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 800; color: #fff; text-transform: uppercase; flex-shrink: 0; display: inline-block; }
.pill.Pending, .pill.pending { background: var(--warning); }
.pill.Processing, .pill.InProgress { background: var(--info); }
.pill.Completed, .pill.approved { background: var(--success); }
.pill.Partial { background: #8B5CF6; }
.pill.Cancelled, .pill.rejected { background: var(--danger); }
.tx-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #F3F4F6; }
.tx-row:last-child { border-bottom: none; }
.tx-row .t1 { font-weight: 800; font-size: 13.5px; line-height: 1.4; word-break: break-word; }
.tx-row .t2 { font-size: 11.5px; color: var(--text-muted); font-weight: 600; margin-top: 2px; }
.tx-amt { font-weight: 900; font-size: 14px; white-space: nowrap; }
.sub-title { font-size: 13px; font-weight: 800; color: var(--text-muted); margin: 18px 0 4px; text-transform: uppercase; letter-spacing: .4px; }
.hc-note { background: #FFF7ED; border-radius: 10px; padding: 9px 12px; font-size: 12.5px; font-weight: 600; color: var(--primary-dark); margin-top: 10px; line-height: 1.5; }
.refill-btn { margin-top: 12px; width: 100%; padding: 10px; border-radius: 12px; border: 2px solid #D1FAE5; background: #ECFDF5; color: #059669; font-weight: 800; font-size: 13px; cursor: pointer; font-family: inherit; }
.refill-btn:disabled { opacity: .6; cursor: default; }

.detail-box { text-align: left; max-width: 420px; max-height: 90vh; overflow-y: auto; }
.detail-box .dh { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; padding-right: 30px; }
.detail-box .dh .selected-pkg-icon { width: 52px; height: 52px; font-size: 22px; border-radius: 14px; }
.detail-box h3 { font-size: 15.5px; font-weight: 900; line-height: 1.4; word-break: break-word; }
.detail-box .dx { position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; border-radius: 50%; border: none; background: #F3F4F6; color: #6B7280; cursor: pointer; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 14px 0; }
.detail-grid div { background: #F9FAFB; border: 1px solid var(--border-color); border-radius: 12px; padding: 10px 12px; }
.detail-grid small { display: block; font-size: 10.5px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; }
.detail-grid b { font-size: 13.5px; font-weight: 800; }
.detail-desc { background: #FFF9F5; border: 1px solid #FFEDD5; border-radius: 12px; padding: 14px; font-size: 13.5px; line-height: 1.75; color: var(--text-main); font-weight: 500; margin-bottom: 16px; word-break: break-word; }
.detail-desc.empty { color: var(--text-muted); font-style: italic; }
.info-text { text-align: left; font-size: 13.5px; line-height: 1.8; color: var(--text-muted); font-weight: 500; max-height: 55vh; overflow-y: auto; margin-bottom: 20px; word-break: break-word; }
.footer-links a { cursor: pointer; }
.hidden-link { display: none !important; }
.fixed-note { font-size: 13px; font-weight: 700; color: var(--primary-dark); background: #FFF7ED; border-radius: 12px; padding: 12px 14px; }
</style>
</head>
